# ---------------------------------------------------------------
# JB RENT PRO — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e configure na Vercel (produção).
# ---------------------------------------------------------------

# URL do projeto Supabase (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública "anon" / "publishable" (Project Settings → API Keys).
# É segura no navegador porque TODAS as tabelas têm RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública do site (usada nos links de recuperação de senha)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chave "service_role" / "secret" — SOMENTE servidor. Nunca prefixar com NEXT_PUBLIC_.
# Necessária a partir da FASE 2 (convite de administradores). Não é usada na FASE 1.
SUPABASE_SERVICE_ROLE_KEY=
